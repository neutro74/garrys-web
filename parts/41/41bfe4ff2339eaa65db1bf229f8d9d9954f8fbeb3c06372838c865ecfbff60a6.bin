/* Derma controls for the launcher, chat and the in-game overlay (web/derma.js cuts GMod's skin into --dk-* variables).
   Border sizes follow lua/skins/default.lua. Before the skin arrives, html:not(.dk-ready) gives flat colours instead.
   Everything is scoped to .dk so the game's own pages are never touched. */
@font-face { font-family: "DermaLarge"; src: url("../asset/garrysmod/resource/fonts/Roboto-Bold.ttf") format("truetype"); font-weight: 700; font-display: swap; }
@font-face { font-family: "DermaLarge"; src: url("../asset/garrysmod/resource/fonts/Roboto-Black.ttf") format("truetype"); font-weight: 900; font-display: swap; }
@font-face { font-family: "DermaLarge"; src: url("../asset/garrysmod/resource/fonts/Roboto-Regular.ttf") format("truetype"); font-weight: 400; font-display: swap; }

.dk {
  --dk-text: #141414; --dk-mid: #5a5d61; --dk-on-grey: #fff; --dk-on-grey-mid: #e4e6e8;
  --dk-sel: #5b8cf8; --dk-hover: rgba(91, 140, 248, .3); --dk-cat: #00a8ff; --dk-tip: #fff5af; --dk-red: #e0201a;
  --dk-small: 13px/1.35 Tahoma, Verdana, "DejaVu Sans", sans-serif;
  --dk-large: "DermaLarge", Roboto, "Helvetica Neue", Arial, sans-serif;
  --dk-ease: cubic-bezier(.2, .8, .2, 1);
  font: var(--dk-small); color: var(--dk-text); text-align: left; -webkit-font-smoothing: auto;
}
:where(.dk) *, :where(.dk) *::before, :where(.dk) *::after { box-sizing: border-box; }
:where(.dk) button { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; }
:where(.dk) a { color: #1a62d6; }
.dk img.si { width: 16px; height: 16px; flex: none; vertical-align: -3px; image-rendering: pixelated; }
:where(.dk) :is(h1, h2, h3, h4) { margin: 0; font-family: var(--dk-large); color: var(--dk-text); letter-spacing: -.01em; }
:where(.dk) kbd { display: inline-block; min-width: 20px; padding: 0 5px; border: 1px solid #9a9a9a; border-bottom-width: 2px; border-radius: 3px; background: #f4f4f4; font: bold 11px/16px Tahoma, Verdana, sans-serif; color: #333; text-align: center; }

/* ---- Window (DFrame) ---- */
.dk-window { position: relative; display: flex; flex-direction: column; padding: 2px;
  border: solid transparent; border-width: 24px 8px 8px; border-image: var(--dk-window) 24 8 8 8 fill / 24px 8px 8px 8px;
  filter: drop-shadow(0 12px 40px rgba(0, 0, 0, .6)); }
html:not(.dk-ready) .dk-window { background: #6c6f72; border-color: #7a7d80; border-radius: 4px; }
.dk-title { position: absolute; left: -2px; right: -2px; top: -22px; height: 20px; display: flex; align-items: center; gap: 6px; color: #fff; font-weight: bold; text-shadow: 0 1px 0 rgba(0, 0, 0, .35); white-space: nowrap; }
.dk-title > img { width: 16px; height: 16px; }
.dk-title .dk-tinfo { margin-left: auto; margin-right: 6px; display: flex; align-items: center; gap: 4px; overflow: hidden; font-weight: normal; color: #e2e4e6; }
.dk-wbtn { flex: none; width: 31px; height: 24px; margin-top: 2px; background: center no-repeat; }
.dk-wbtn.mini { background-image: var(--dk-mini); } .dk-wbtn.mini:hover { background-image: var(--dk-mini-h); }
.dk-wbtn.maxi { background-image: var(--dk-maxi); } .dk-wbtn.maxi:hover { background-image: var(--dk-maxi-h); }
.dk-wbtn.close { background-image: var(--dk-close); } .dk-wbtn.close:hover { background-image: var(--dk-close-h); } .dk-wbtn.close:active { background-image: var(--dk-close-d); }
html:not(.dk-ready) .dk-wbtn { background: #c8c8c8; border-radius: 3px; width: 24px; height: 18px; margin-top: 3px; }
@keyframes dk-pop { from { opacity: 0; scale: .95; } }
.dk-window.pop { animation: dk-pop .4s var(--dk-ease) both; }

/* ---- Buttons (DButton) ---- */
.dk-btn, .dk .btn, .dk .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 24px; padding: 0 10px; color: #333; white-space: nowrap; text-decoration: none; font: var(--dk-small);
  border: 4px solid transparent; border-image: var(--dk-button) 8 fill / 4px; transition: translate .1s; cursor: pointer; }
.dk-btn:hover, .dk .btn:hover, .dk .btn-primary:hover { border-image-source: var(--dk-button-h); }
.dk-btn:active, .dk-btn.down, .dk .btn:active, .dk .btn-primary:active { border-image-source: var(--dk-button-d); translate: 0 1px; }
.dk-btn:disabled, .dk .btn:disabled, .dk .btn-primary:disabled { border-image-source: var(--dk-button-dead); color: #999; cursor: default; translate: none; }
.dk-btn.blue, .dk .btn-primary { color: #fff; border-image-source: var(--dk-tabbar); border-image-slice: 4 fill; text-shadow: 0 1px 0 rgba(0, 0, 0, .3); }
.dk-btn.blue:hover, .dk .btn-primary:hover { border-image-source: var(--dk-tabbar); filter: brightness(1.08); }
.dk-btn.big { height: 40px; padding: 0 20px; font: 700 15px var(--dk-large); border-width: 8px; border-image-width: 8px; }
html:not(.dk-ready) .dk-btn, html:not(.dk-ready) .dk .btn { background: #e3e3e3; border: 1px solid #555; border-radius: 3px; }
html:not(.dk-ready) .dk-btn.blue, html:not(.dk-ready) .dk .btn-primary { background: #3fb0e8; border: 1px solid #1d7fb0; border-radius: 3px; }
.dk .btn-primary:disabled { border-image-source: var(--dk-button-dead); color: #999; text-shadow: none; filter: none; }

/* ---- Tabs (DPropertySheet) ---- */
.dk-sheet { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.dk-tabs { position: relative; display: flex; align-items: flex-end; gap: 2px; padding-left: 4px; height: 28px; flex: none; }
.dk-tab { position: relative; display: flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px 2px; color: rgba(0, 0, 0, .75); white-space: nowrap;
  border: solid transparent; border-width: 8px 6px 0; border-image: var(--dk-tab-off) 8 8 0 8 fill / 8px 6px 0 6px; transition: height .2s var(--dk-ease), color .2s; }
.dk-tab:hover { color: #000; height: 25px; }
.dk-tab.on { height: 28px; color: #fff; text-shadow: 0 1px 1px rgba(0, 0, 0, .6); border-image-source: var(--dk-tab-on); z-index: 1; }
html:not(.dk-ready) .dk-tab { background: #787a7c; border-radius: 4px 4px 0 0; }
html:not(.dk-ready) .dk-tab.on { background: #9da1a5; }
.dk-badge { min-width: 16px; padding: 0 4px; border-radius: 8px; background: var(--dk-red); color: #fff; font-size: 10px; font-weight: bold; line-height: 15px; text-align: center; text-shadow: none; }
.dk-badge[hidden] { display: none; }
.dk-tabbody { position: relative; flex: 1; min-height: 0; border: 8px solid transparent; border-image: var(--dk-tabctl) 8 fill / 8px; }
html:not(.dk-ready) .dk-tabbody { background: #9da1a5; }
.dk-page { position: absolute; inset: 0; overflow: auto; padding: 4px; transition: opacity .25s var(--dk-ease), translate .25s var(--dk-ease); scrollbar-width: thin; scrollbar-color: #7d8185 transparent; }
.dk-page[hidden] { display: block !important; opacity: 0; translate: 12px 0; pointer-events: none; visibility: hidden; }
.dk-onGrey, .dk-page > .dk-say { color: var(--dk-on-grey); text-shadow: 0 1px 0 rgba(0, 0, 0, .4); }

/* ---- Panels (DPanel) and collapsible categories (DCollapsibleCategory) ---- */
.dk-panel { border: 8px solid transparent; border-image: var(--dk-panel-bright) 16 fill / 8px; padding: 4px; }
.dk-panel.grey { border-image-source: var(--dk-panel); }
.dk-panel.dark { border-image-source: var(--dk-panel-dark); }
html:not(.dk-ready) .dk-panel { background: #fff; border-color: #ccc; border-width: 1px; border-radius: 4px; }
.dk-cat { border: 6px solid transparent; border-image: var(--dk-cat-outer) 8 fill / 6px; }
html:not(.dk-ready) .dk-cat { background: #f2f2f2; border-radius: 4px; }
.dk-cat-head { display: flex; align-items: center; gap: 6px; width: 100%; height: 22px; padding: 0 6px; color: #fff !important; font-weight: bold; text-shadow: 0 1px 0 rgba(0, 0, 0, .4); text-align: left;
  border: 4px solid transparent; border-image: var(--dk-cat-head) 8 fill / 4px; }
html:not(.dk-ready) .dk-cat-head { background: var(--dk-cat); border-radius: 3px; }
.dk-cat-head .dk-badge { margin-left: 2px; }
.dk-cat-head::after { content: ""; margin-left: auto; width: 0; height: 0; border: 4px solid transparent; border-top-color: #fff; translate: 0 2px; transition: rotate .25s var(--dk-ease); }
.dk-cat.shut .dk-cat-head::after { rotate: -90deg; }
.dk-cat-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .3s var(--dk-ease); }
.dk-cat.shut .dk-cat-body { grid-template-rows: 0fr; }
.dk-cat-body > div { overflow: hidden; min-height: 0; }
.dk-row { display: flex; align-items: center; gap: 6px; width: 100%; min-height: 22px; padding: 2px 6px; color: var(--dk-text); text-align: left; }
.dk-row:nth-child(even) { background: rgba(0, 0, 0, .05); }
button.dk-row:hover, .dk-row.hov:hover { background: var(--dk-hover); }
.dk-row.sel { background: var(--dk-sel); color: #fff; }
.dk-row > small { margin-left: auto; color: var(--dk-mid); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dk-row.sel > small { color: #fff; }
.dk-row .act { opacity: 0; transition: opacity .15s; }
.dk-row:hover .act, .dk-row:focus-within .act { opacity: 1; }
.dk-p { margin: 0; padding: 4px 6px; }
.dk-p b { display: block; }
.dk-p span { color: var(--dk-mid); }

/* ---- Text entry (DTextEntry), checkboxes, combo ---- */
.dk input:not([type=checkbox]):not([type=radio]):not([type=color]):not([type=file]), .dk textarea, .dk select {
  min-height: 24px; padding: 2px 6px; color: var(--dk-text); font: var(--dk-small); outline: 0; background: none;
  border: 4px solid transparent; border-image: var(--dk-textbox) 4 fill / 4px; border-radius: 0; user-select: text; }
.dk input:not([type=checkbox]):not([type=radio]):not([type=color]):focus, .dk textarea:focus, .dk select:focus { border-image-source: var(--dk-textbox-f); }
.dk input:disabled, .dk textarea:disabled { border-image-source: var(--dk-textbox-off); cursor: not-allowed; }
html:not(.dk-ready) .dk input:not([type=checkbox]):not([type=radio]):not([type=color]), html:not(.dk-ready) .dk textarea, html:not(.dk-ready) .dk select { background: #fff; border: 1px solid #222; }
.dk input::placeholder, .dk textarea::placeholder { color: #808080; }
.dk input[type=checkbox] { appearance: none; width: 15px; height: 15px; margin: 0 4px 0 0; vertical-align: -3px; background: var(--dk-check) no-repeat; cursor: pointer; }
.dk input[type=checkbox]:checked { background-image: var(--dk-check-on); }
html:not(.dk-ready) .dk input[type=checkbox] { appearance: auto; }
.dk select { appearance: none; padding-right: 24px; border-width: 4px 4px 4px 4px; border-image: var(--dk-combo) 8 32 8 8 fill / 4px 24px 4px 4px; }
.dk select:hover { border-image-source: var(--dk-combo-h); }

/* ---- Tree (DTree), lists (DListView), progress (DProgress) ---- */
.dk-tree { overflow: auto; padding: 4px 2px; border: 8px solid transparent; border-image: var(--dk-tree) 16 fill / 8px; scrollbar-width: thin; }
html:not(.dk-ready) .dk-tree { background: #fff; border: 1px solid #888; }
.dk-node { position: relative; display: flex; align-items: center; gap: 5px; width: 100%; min-height: 20px; padding: 1px 4px; text-align: left; color: var(--dk-text); white-space: nowrap; }
.dk-node > span { overflow: hidden; text-overflow: ellipsis; }
.dk-node.head { font-weight: bold; color: #444; margin-top: 4px; cursor: default; }
.dk-node.kid { padding-left: 20px; }
button.dk-node:hover { background: var(--dk-hover); }
.dk-node.on { background: var(--dk-sel); color: #fff; }
.dk-node.unread { font-weight: bold; }
.dk-node .dk-badge { margin-left: auto; }
.dk-node .dk-add { margin-left: auto; padding: 0 4px; color: #555; font-weight: bold; }
.dk-list { border: 6px solid transparent; border-image: var(--dk-list-bg) 8 fill / 6px; }
html:not(.dk-ready) .dk-list { background: #fff; border: 1px solid #888; }
.dk-bar { height: 22px; border: 6px solid transparent; border-image: var(--dk-prog-back) 8 fill / 6px; overflow: hidden; }
.dk-bar > div { height: 100%; width: 0; margin: -2px; border: 6px solid transparent; border-image: var(--dk-prog-front) 8 fill / 6px; transition: width .3s linear; }
html:not(.dk-ready) .dk-bar { background: #ddd; } html:not(.dk-ready) .dk-bar > div { background: #3fb0e8; }

/* ---- Tooltips (the skin's yellow box), menus ---- */
.dk-tooltip { position: fixed; z-index: 2147483647; max-width: min(320px, calc(100vw - 8px)); padding: 2px 4px; color: #000; font: var(--dk-small); white-space: normal; pointer-events: none;
  border: 4px solid transparent; border-image: var(--dk-tooltip) 8 fill / 4px; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, .3)); animation: dk-tip .12s ease-out; }
.dk-tooltip[hidden] { display: none; }
html:not(.dk-ready) .dk-tooltip { background: var(--dk-tip); border: 1px solid #000; }
@keyframes dk-tip { from { opacity: 0; translate: 0 3px; } }
.dk-menu { display: flex; flex-direction: column; min-width: 180px; padding: 4px; border: 8px solid transparent; border-image: var(--dk-menu) 8 fill / 4px; filter: drop-shadow(0 4px 10px rgba(0, 0, 0, .35)); animation: dk-fade .12s ease-out; }
html:not(.dk-ready) .dk-menu { background: #fafafa; border: 1px solid #333; }
.dk-menu > button { display: flex; align-items: center; gap: 6px; padding: 4px 6px; text-align: left; }
.dk-menu > button:hover { background: var(--dk-hover); }
@keyframes dk-fade { from { opacity: 0; } }

/* ---- Crop window (web/crop.js) ---- */
.gw-crop { position: fixed; inset: 0; z-index: 2147483002; display: grid; place-items: center; padding: 16px; background: rgba(0, 0, 0, .5); animation: dk-fade .15s ease-out; }
.gw-crop .dk-window { width: min(580px, 100%); }
.gw-crop .dk-panel { display: flex; flex-direction: column; gap: 6px; }
.gw-crop-stage { position: relative; height: 320px; overflow: hidden; background: #2a2a2a; outline: 1px solid #000; cursor: grab; touch-action: none; }
.gw-crop-stage.grab { cursor: grabbing; }
.gw-crop-stage canvas { display: block; }
.gw-crop-frame { position: absolute; box-shadow: 0 0 0 2000px rgba(0, 0, 0, .55); outline: 2px solid #fff; pointer-events: none; }
.gw-crop-row { display: flex; align-items: center; gap: 6px; }
.gw-crop-row input[type=range] { flex: 1; }
.gw-crop-note { margin: 0; color: var(--dk-mid); font-size: 12px; }

@media (prefers-reduced-motion: reduce) { .dk *, .dk *::before, .dk *::after, .dk-window.pop { animation: none !important; transition: none !important; } }
